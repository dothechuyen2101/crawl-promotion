# ============ .env ở thư mục gốc (worker đọc file này) ============
# Supabase: Project Settings → API Keys. Secret key CHỈ đặt ở máy worker và biến server của Vercel.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Bot Telegram (@BotFather) + chat id của bạn để nhận cảnh báo lỗi (hỏi @userinfobot để biết chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# AccessTrade (pub.accesstrade.vn → thông tin cá nhân → access key). Để trống thì bỏ qua nguồn này.
ACCESSTRADE_TOKEN=

# URL web trên Vercel, dùng để tạo link trong tin nhắn Telegram
PUBLIC_SITE_URL=https://ten-app.vercel.app

# Proxy (để trống = không dùng). Có thể đặt riêng theo sàn: PROXY_URL_SHOPEE, PROXY_URL_TIKI, ...
PROXY_URL=

# ============ apps/web/.env.local (và Environment Variables trên Vercel) ============
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# RATE_LIMIT_SALT=<chuỗi ngẫu nhiên>
# PUBLIC_SITE_URL=https://ten-app.vercel.app
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
